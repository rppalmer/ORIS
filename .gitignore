.DS_Store
.env
.env.*
!.env.example
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
# The trailing glob matters: SQLite's -wal and -shm companions hold conversation
# content that has not been folded into the database file yet.
*.sqlite*
*.sqlite3
# Only scheduled run records, evaluation results, and the rendered plist remain
# here; conversation content, threat reports, exports, and traces moved to
# ~/.oris, which no checkout can accidentally commit.
artifacts/
logs/
# Local state written by the LangGraph development server.
.langgraph_api/
dist/

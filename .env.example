# Copy this to ~/.oris/.env, not to the project root. ORIS reads that one file
# wherever it is started from, so the interactive session and the scheduler
# always agree about which conversation history and knowledge index are live.
LOCAL_LLM_BASE_URL=http://localhost/v1
LOCAL_LLM_MODEL=replace-with-model-id
LOCAL_LLM_API_KEY=replace-with-local-api-key
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_LLM_MAX_HISTORY_TOKENS=8000
TAVILY_API_KEY=replace-with-tavily-api-key
LANGSMITH_TRACING=false
LOCAL_TRACING_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
# The four storage paths below already default to these values. Set them only
# to point at directories you already have; they are the migration lever.
# Phoenix's own variable; start-phoenix.sh and the terminal interface both use it.
# PHOENIX_WORKING_DIR=~/.oris/traces/phoenix
# ORIS_CHECKPOINT_DB_PATH=~/.oris/data/checkpoints.sqlite
# ORIS_KNOWLEDGE_DB_PATH=~/.oris/data/knowledge.sqlite
# ORIS_THREAT_REPORT_DIR=~/.oris/artifacts/threat
NET_RAZOR_PYTHON_EXECUTABLE=/path/to/net-razor/.venv/bin/python
THREATSYFT_PYTHON_EXECUTABLE=/path/to/threatsyft/.venv/bin/python
THREATSYFT_ROOT=/path/to/threatsyft
